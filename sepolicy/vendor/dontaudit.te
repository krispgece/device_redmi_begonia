# Apps are no longer allowed open access to /dev/ashmem, unless they
# target API level < Q.
dontaudit untrusted_app ashmem_device:chr_file open;

# Neverallow: no domain should be allowed to ptrace init 
# at system/sepolicy/public/init.te
dontaudit crash_dump init:process ptrace;

# NfcConfig::loadConfig() stat()s /data/vendor/nfc/libnfc-nci-update.conf,
# which the NXP HAL on begonia never creates.
dontaudit nfc nfc_data_vendor_file:dir search;

# mnld reads an undeclared MTK log-system property.
dontaudit mnld default_prop:file r_file_perms;

# vold's idle maintenance tries to open /mnt/vendor/persist for fstrim.
dontaudit vold persist_data_file:dir r_dir_perms;
