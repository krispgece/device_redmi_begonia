# Graphics
genfscon sysfs /devices/platform/13040000.mali                                                                                  u:object_r:sysfs_gpu:s0

# Leds
genfscon sysfs /devices/platform/11016000.i2c5/i2c-5/5-0034/mt6360_pmu_rgbled.4.auto/leds u:object_r:sysfs_leds:s0

# Performance
genfscon sysfs /devices/system/cpu/cpufreq/mtk/.cluster_(min|max)_freq                                                          u:object_r:sysfs_mtk_cpufreq:s0
genfscon sysfs /kernel/gpu/gpu_(min|max)_clock                                                                                  u:object_r:sysfs_mtk_gpufreq:s0

# Torch
genfscon sysfs /devices/platform/flashlights_mt6360/torchbrightness                                                             u:object_r:vendor_torch_sysfs:s0

# Extcon (WiredAccessoryManager reads the cable names at boot)
genfscon sysfs /devices/platform/extcon_usb/extcon                                                                              u:object_r:sysfs_extcon:s0

# Scheduler tunable written from init.mt6785.rc
genfscon proc /sys/kernel/sched_stune_task_threshold                                                                            u:object_r:proc_sched:s0

# Thermal
genfscon sysfs /devices/virtual/thermal/thermal_message                                                                         u:object_r:vendor_sysfs_thermal_message:s0
